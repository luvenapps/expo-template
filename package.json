{
  "name": "template-starter",
  "version": "1.0.0",
  "license": "MIT",
  "author": "LuvenApps <github@luvenapps.com>",
  "main": "index.js",
  "scripts": {
    "prestart": "npm run troubleshoot && node scripts/prepare-native-worktree.js start",
    "start": "NODE_OPTIONS='--max-old-space-size=8192' expo start",
    "preios": "node scripts/prepare-native-worktree.js ios",
    "android": "node scripts/run-native.mjs android",
    "preandroid": "node scripts/prepare-native-worktree.js android",
    "ios": "node scripts/run-native.mjs ios",
    "web": "npm start -- --web",
    "web:https": "npx expo export --platform web && cp public/firebase-messaging-sw.js dist/ && npx serve -s dist -l 3000 --ssl-cert ./certs/localhost+2.pem --ssl-key ./certs/localhost+2-key.pem",
    "pretest": "npm run type-check",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "setup:local": "bash scripts/setup-local-deps.sh",
    "doctor": "expo-doctor --verbose",
    "start:ci": "expo start --dev-client --no-dev --minify --port 8081 --clear",
    "e2e:ios": "maestro test .maestro/flows/smoke.ios.yaml",
    "e2e:android": "maestro test .maestro/flows/smoke.android.yaml",
    "commit": "cz",
    "troubleshoot": "node scripts/troubleshoot.mjs",
    "db:migrate": "node scripts/generate-migrations.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.sqlite.ts",
    "db:generate:postgres": "node scripts/generate-postgres-migration.mjs",
    "db:generate-rls": "node scripts/generate-rls-policies.mjs",
    "db:push": "drizzle-kit push --config=drizzle.config.sqlite.ts",
    "db:clean": "node scripts/clean-migrations.mjs",
    "supabase:push": "npx supabase db push",
    "supabase:dev": "node scripts/supabase-dev.mjs",
    "supabase:deploy": "node scripts/supabase-deploy.mjs",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:prod:ios": "eas build --platform ios --profile production",
    "build:prod:android": "eas build --platform android --profile production",
    "submit:prod:ios": "eas submit --platform ios --profile production",
    "submit:prod:android": "eas submit --platform android --profile production",
    "version:bump": "node scripts/bump-version.mjs",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@react-native-firebase/analytics": "^27.1.0",
    "@react-native-firebase/app": "^27.1.0",
    "@react-native-firebase/crashlytics": "^27.1.0",
    "@react-native-firebase/in-app-messaging": "^27.1.0",
    "@react-native-firebase/messaging": "^27.1.0",
    "@react-native-firebase/remote-config": "^27.1.0",
    "@react-navigation/elements": "^2.9.45",
    "@react-navigation/native": "^7.5.1",
    "@supabase/supabase-js": "^2.95.3",
    "@tamagui/core": "3.1.10",
    "@tamagui/font-inter": "3.1.10",
    "@tamagui/helpers-icon": "3.1.10",
    "@tamagui/metro-plugin": "3.1.10",
    "@tamagui/web": "3.1.10",
    "@tanstack/query-async-storage-persister": "^5.90.22",
    "@tanstack/query-sync-storage-persister": "^5.90.22",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-persist-client": "^5.90.22",
    "dayjs": "^1.11.19",
    "drizzle-orm": "^0.45.1",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-background-task": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "firebase": "^13.1.0",
    "i18next": "^26.5.12",
    "idb-keyval": "^6.2.2",
    "libphonenumber-js": "^1.12.36",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-mmkv": "^4.1.2",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tamagui": "3.1.10",
    "uuid": "^14.0.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@expo/ngrok": "^4.1.3",
    "@tamagui/cli": "3.1.10",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "@types/semver": "^7.7.1",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.38.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "expo-dev-client": "~58.0.18",
    "expo-doctor": "^1.17.14",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "semver": "^7.7.4",
    "serve": "^14.2.5",
    "supabase": "^2.76.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "react-server-dom-webpack": "19.3.1",
    "react-dom": "19.3.0",
    "react": "19.3.0",
    "react-test-renderer": "19.3.0",
    "react-native-web": "^0.21.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run lint"
    ],
    "*.*": [
      "npm run format:check"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "x-template": {
    "bundleIdBase": "com.luvenapps",
    "templateName": "template-starter"
  }
}
