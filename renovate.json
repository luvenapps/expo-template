{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["github-actions", "npm"],
  "ignorePaths": ["template-sync/**"],
  "timezone": "America/New_York",
  "schedule": ["after 3am and before 5am"],
  "dependencyDashboard": {
    "enabled": true
  },
  "packageRules": [
    {
      "groupName": "ci-tooling",
      "description": "Batch patch and minor updates to template CI actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor"]
    },
    {
      "description": "Open GitHub Actions major updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "Wait three days before npm updates",
      "matchManagers": ["npm"],
      "minimumReleaseAge": "3 days"
    }
  ],
  "prConcurrentLimit": 2
}
